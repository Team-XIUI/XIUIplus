#pragma once

namespace xiui
{
    inline constexpr char release_version[] = "@XIUI_VERSION@";
    // Ashita only shows a number with two decimals, so 0.2.1 appears there as 0.21.
    inline constexpr double plugin_version = @PROJECT_VERSION_MAJOR@ + @PROJECT_VERSION_MINOR@ / 10.0 + @PROJECT_VERSION_PATCH@ / 100.0;
}
