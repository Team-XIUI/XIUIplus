file(READ "${CMAKE_SOURCE_DIR}/tests/checks.json" check_catalog)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/tests/checks.json")
string(JSON check_count LENGTH "${check_catalog}" checks)
math(EXPR check_last "${check_count} - 1")
foreach(index RANGE 0 ${check_last})
    string(JSON name GET "${check_catalog}" checks ${index} name)
    string(JSON target GET "${check_catalog}" checks ${index} target)
    string(JSON requires_arguments GET "${check_catalog}" checks ${index} requires_arguments)
    if(requires_arguments)
        continue()
    endif()
    string(JSON argument_count LENGTH "${check_catalog}" checks ${index} arguments)
    set(arguments)
    if(argument_count GREATER 0)
        math(EXPR argument_last "${argument_count} - 1")
        foreach(argument_index RANGE 0 ${argument_last})
            string(JSON argument GET "${check_catalog}" checks ${index} arguments ${argument_index})
            string(REPLACE "{root}" "${CMAKE_SOURCE_DIR}" argument "${argument}")
            list(APPEND arguments "${argument}")
        endforeach()
    endif()
    add_test(NAME xiui_focus_${name} COMMAND ${target} ${arguments})
    set_tests_properties(xiui_focus_${name} PROPERTIES LABELS "focused")
endforeach()

find_program(XIUI_POWERSHELL NAMES pwsh powershell)
if(XIUI_POWERSHELL)
    add_test(NAME xiui_capture_defaults_smoke COMMAND "${XIUI_POWERSHELL}" -NoProfile -File
        "${CMAKE_SOURCE_DIR}/tests/settings/capture_defaults_smoke.ps1" -Executable "$<TARGET_FILE:xiui_capture_defaults>")
endif()
